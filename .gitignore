# --- THE FIX FOR IMAGES ---
# Ensure the public directory is NOT ignored
!/public/
# If you previously ignored all images globally, un-ignore them for public:
!/public/**/*.png
!/public/**/*.jpg
!/public/**/*.jpeg
!/public/**/*.svg
!/public/**/*.webp
!/public/**/*.ico